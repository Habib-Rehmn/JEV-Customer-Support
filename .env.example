BEATAPI_API_KEY=
BEATAPI_BASE_URL=https://api.beatapi.io
JEV_MODEL=jev-1.13-free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low   # leave empty for non-reasoning models (e.g. gpt-4o-mini)

POSTGRES_USER=jev
POSTGRES_PASSWORD=jev
POSTGRES_DB=jev_support

JWT_SECRET=change-me   # generate one: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# Business rules (optional overrides)
RULE_MIN_CONFIDENCE=0.70
RULE_REFUND_APPROVAL_LIMIT=500
RULE_MAX_REFUNDS_30_DAYS=3
RULE_REPLACEMENT_WINDOW_DAYS=30
RULE_AUTO_REPLACEMENT_LIMIT=100
RULE_SIGNAL_THRESHOLD=0.5
